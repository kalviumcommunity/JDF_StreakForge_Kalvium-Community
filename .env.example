# StreakForge Report Generation & Email Delivery Configuration
# 
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to version control — it contains secrets.

# SMTP Email Configuration
# For Gmail: use an App Password (not your regular Gmail password)
# See: https://support.google.com/accounts/answer/185833
SENDER_EMAIL=your-email@gmail.com
SENDER_PASSWORD=your-app-password-here

# SMTP Server Settings
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Report Recipients (comma-separated if multiple)
# Example: REPORT_RECIPIENTS=manager@example.com,director@example.com
REPORT_RECIPIENTS=stakeholder@example.com

# Report Schedule (cron-like format, optional)
# Example: "0 9 * * 1" = Every Monday at 9:00 AM
# REPORT_SCHEDULE=0 9 * * 1
